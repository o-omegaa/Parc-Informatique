# Copy these values to your local environment or to the ignored application-dev.yml file.
SUPPLIER_DB_URL=jdbc:mysql://localhost:3306/supplier_portal?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SUPPLIER_DB_USERNAME=supplier_portal_user
SUPPLIER_DB_PASSWORD=replace-with-your-local-password
SUPPLIER_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SUPPLIER_STORAGE_DIRECTORY=./storage/documents
SUPPLIER_STORAGE_ENCRYPTION_KEY=replace-with-a-base64-aes-256-key
APP_BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-initial-admin-password
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SUPPLIER_SMTP_ENABLED=false
SUPPLIER_SMTP_HOST=smtp.example.com
SUPPLIER_SMTP_PORT=587
SUPPLIER_SMTP_USERNAME=notifications@example.com
SUPPLIER_SMTP_PASSWORD=use-an-app-password-or-smtp-secret
SUPPLIER_SMTP_FROM=notifications@example.com
SUPPLIER_SMTP_AUTH=true
SUPPLIER_SMTP_STARTTLS=true
SUPPLIER_SMTP_TRUST_HOST=smtp.example.com
# Example for a deployed frontend: https://portal.example.ma/?resetToken=%s
SUPPLIER_PASSWORD_RESET_URL=
